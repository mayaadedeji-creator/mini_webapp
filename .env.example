# Copy this file to .env.local (which git ignores) and fill in the values.

# Affirmations — get a free key at https://apileague.com
# Without it, affirmations come from a small built-in list.
VITE_APILEAGUE_KEY=

# Saving gifts online so links open on any device — from your Supabase project
# (Connect button, or Settings → API Keys). Use the publishable key (sb_publishable_...),
# never the secret key. Without these, gifts are saved in this browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
